<UserControl x:Class="Caisse.Desktop.RetailPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
  <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshCommand}"/><StackPanel><TextBlock Text="{Binding PanelTitle}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding SessionSummary}" Foreground="#087F70" Margin="0,5,0,0"/></StackPanel></DockPanel>
    <TabControl x:Name="RetailTabs" Grid.Row="1" Background="White" BorderBrush="#DFE7EB">
      <TabItem Header="Session &amp; espèces">
        <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel>

            <StackPanel Visibility="{Binding CanStartShift, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="Ouverture" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Compte connecté"/><TextBlock Text="{Binding OperatorName}" FontSize="23" FontWeight="Bold" Margin="0,8,0,16"/><TextBlock Text="Fond initial en espèces"/><TextBox Text="{Binding Opening}" Margin="0,4,0,10"/><Button Visibility="{Binding IsCashier, Converter={StaticResource VisibleWhenTrue}}" Content="Démarrer mon shift" Command="{Binding OpenCommand}" Style="{StaticResource Primary}" Margin="0,0,0,18"/></StackPanel>
            <TextBlock Text="Clôture" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Espèces attendues" Margin="0,8,0,4"/><TextBlock Text="{Binding ExpectedText}" FontSize="25" FontWeight="Bold" Foreground="#087F70"/>
            <StackPanel IsEnabled="{Binding CanClose}"><TextBlock Text="Espèces réellement comptées" Margin="0,12,0,4"/><TextBox Text="{Binding Counted, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding ClosingDifference}" Margin="0,8,0,12" TextWrapping="Wrap"/><Button Content="Clôturer la session…" Command="{Binding CloseCommand}" Margin="0"/></StackPanel>
<TextBlock Text="Le compte connecté est enregistré automatiquement pour ce shift. Une ancienne session sans compte doit être clôturée par un manager." FontSize="13" Foreground="#60747D" TextWrapping="Wrap" Margin="0,14,0,0"/>
          </StackPanel></ScrollViewer>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Visibility="{Binding IsCashier, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding IsOpen}" Margin="0,0,0,14"><TextBlock Text="Entrée / sortie d’espèces" FontSize="20" FontWeight="SemiBold"/><Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Montant"/><TextBox Text="{Binding MovementAmount}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Motif obligatoire"/><TextBox Text="{Binding MovementReason}" Margin="0,4,0,0"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="Entrée d’espèces…" Command="{Binding CashInCommand}"/><Button Content="Sortie d’espèces…" Command="{Binding CashOutCommand}"/></StackPanel></StackPanel>
            <GroupBox Grid.Row="1" Header="Sessions (dates UTC)" Margin="0,0,0,10"><DataGrid ItemsSource="{Binding Sessions}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45"/><DataGridTextColumn Header="Caissier" Binding="{Binding Operator}" Width="*"/><DataGridTextColumn Header="Ouverture" Binding="{Binding OpenedAt, StringFormat=dd/MM HH:mm}" Width="110"/><DataGridTextColumn Header="État" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="Attendu" Binding="{Binding ExpectedAtClose, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="Compté" Binding="{Binding CountedAmount, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="Écart" Binding="{Binding Difference, StringFormat=N2}" Width="75"/></DataGrid.Columns></DataGrid></GroupBox>
            <GroupBox Grid.Row="2" Header="Mouvements d’espèces (dates UTC)"><DataGrid ItemsSource="{Binding Movements}"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding CashSessionId}" Width="70"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="110"/><DataGridTextColumn Header="Motif" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Montant signé" Binding="{Binding Amount, StringFormat=N2}" Width="125"/></DataGrid.Columns></DataGrid></GroupBox>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Retours &amp; remboursements">
        <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="520"/></Grid.ColumnDefinitions>
          <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Grid.ColumnSpan" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsManager}" Value="True"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12"><TextBlock Text="Rechercher le ticket original"/><TextBox Text="{Binding SaleSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/></StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"><DataGrid.Columns><DataGridTextColumn Header="Ticket" Binding="{Binding Number}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid>
            <Button Grid.Row="2" Content="Voir le détail du retour sélectionné" Click="RefundDetails_Click" Margin="0,12,0,12"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Refunds}" SelectedItem="{Binding SelectedRefund}"><DataGrid.Columns><DataGridTextColumn Header="Ticket" Binding="{Binding SaleNumber}" Width="*"/><DataGridTextColumn Header="Remboursé" Binding="{Binding Amount, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid>
          </Grid>
          <ScrollViewer Visibility="{Binding IsCashier, Converter={StaticResource VisibleWhenTrue}}" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Remboursement par article" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding SelectedSaleSummary}" TextWrapping="Wrap" Margin="0,10,0,14"/>
              <ItemsControl ItemsSource="{Binding RefundItems}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#DFE7EB" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel>
                  <TextBlock Text="{Binding Line.ProductName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding Remaining, StringFormat=Encore remboursable : {0}}" Foreground="#60747D" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Command="{Binding Minus}"/><TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,0,8,0" HorizontalContentAlignment="Center"/><Button Content="+" Command="{Binding Plus}" Margin="0"/></StackPanel>
                  </DockPanel>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="Motif du remboursement" Margin="0,14,0,8"/>
              <ComboBox x:Name="ReasonChoice" ItemsSource="{Binding Reasons}" SelectedItem="{Binding ReasonCode}" SelectionChanged="Reason_Changed"/>
              <TextBox x:Name="OtherReasonBox" Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" Margin="0,10,0,10" Visibility="{Binding IsOtherReason, Converter={StaticResource VisibleWhenTrue}}"/>
              <CheckBox Content="Remettre les quantités choisies en stock" IsChecked="{Binding Restock}" Margin="0,10,0,10"/>
              <TextBlock Text="{Binding RefundAmountText}" FontSize="30" FontWeight="Bold" Foreground="#087F70"/>
              <TextBlock Text="{Binding RefundPolicy}" TextWrapping="Wrap" Foreground="#60747D" Margin="0,8,0,14"/>
              <Button Content="Confirmer le remboursement…" Command="{Binding RefundCommand}" Style="{StaticResource Primary}" Margin="0"/>
              <TextBlock Text="Le moyen de remboursement est celui du ticket original. Pour une carte, effectuer le remboursement sur le terminal bancaire avant de confirmer." TextWrapping="Wrap" Foreground="#60747D" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>      <TabItem Header="Rapports" Visibility="{Binding IsManager, Converter={StaticResource VisibleWhenTrue}}">
        <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Du"/><DatePicker SelectedDate="{Binding From}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Au (inclus)"/><DatePicker SelectedDate="{Binding To}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="Exporter le rapport CSV…" Click="Export_Click" HorizontalAlignment="Right"/></Grid>
            <UniformGrid Columns="3" Margin="0,18,0,12"><StackPanel><TextBlock Text="Ventes après remises"/><TextBlock Text="{Binding Gross}" FontSize="25" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Remboursements"/><TextBlock Text="{Binding Returned}" FontSize="25" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Ventes nettes de retours"/><TextBlock Text="{Binding Net}" FontSize="25" FontWeight="Bold" Foreground="#087F70"/></StackPanel></UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{Binding CashNet, StringFormat=Espèces nettes : {0}}" Margin="0,0,24,0"/><TextBlock Text="{Binding CardNet, StringFormat=Carte nette : {0}}"/></StackPanel><TextBlock Text="{Binding ReportCount}" Foreground="#60747D" Margin="0,0,0,10"/><TextBlock Text="Les retours sont déduits à leur date de remboursement. Les fonds et mouvements d’espèces ne sont pas du chiffre d’affaires." FontSize="11" Foreground="#60747D" TextWrapping="Wrap" Margin="0,0,0,12"/>
          </StackPanel><DataGrid ItemsSource="{Binding Report}"><DataGrid.Columns><DataGridTextColumn Header="Date locale" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="165"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="Paiement" Binding="{Binding Payment}" Width="190"/><DataGridTextColumn Header="Montant signé" Binding="{Binding Amount, StringFormat=N2}" Width="130"/></DataGrid.Columns></DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Journal de stock" Visibility="{Binding IsManager, Converter={StaticResource VisibleWhenTrue}}">
        <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/></Grid.RowDefinitions><TextBlock Text="Traçabilité des entrées, ventes, ajustements et retours" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><DataGrid Grid.Row="1" ItemsSource="{Binding StockJournal}"><DataGrid.Columns><DataGridTextColumn Header="Date locale" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Produit" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Quantité ±" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="Motif / référence" Binding="{Binding Reason}" Width="310"/></DataGrid.Columns></DataGrid><GroupBox Grid.Row="2" Header="À réapprovisionner · stock ≤ 5" Margin="0,12,0,0"><DataGrid ItemsSource="{Binding LowStock}"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Barcode}" Width="150"/><DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="100"/></DataGrid.Columns></DataGrid></GroupBox></Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E4EEEB" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#215A4B"/></Border>
  </Grid>
</UserControl>
