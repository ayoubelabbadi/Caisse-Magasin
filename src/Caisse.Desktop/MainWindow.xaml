<Window x:Class="Caisse.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Caisse.Desktop" Title="Caisse · Gestion du magasin" Icon="Assets/caisse.ico" Width="1380" Height="880" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Language="fr-FR" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Grid x:Name="MainContent" Background="#F5F4EF" MinWidth="1120" MinHeight="720">
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="28,16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#102F36"/><GradientStop Color="#17675F" Offset="1"/></LinearGradientBrush></Border.Background>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Employés &amp; accès" Click="Accounts_Click" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Verrouiller" Click="Lock_Click" Margin="0,0,16,0"/><StackPanel><TextBlock Text="{Binding WorkspaceTitle}" Foreground="#80D9BB" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding AccountLabel}" Foreground="#B4C8CF" Margin="0,7,0,0"/></StackPanel></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Background="White" CornerRadius="12" Width="54" Height="54" Margin="0,0,14,0" Padding="3"><Image Source="Assets/logo.png" Stretch="Uniform" AutomationProperties.Name="Logo Caisse"/></Border><StackPanel><TextBlock Text="caisse." Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding Settings.Name}" Foreground="#B4C8CF"/></StackPanel></StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,18,24,14" Background="Transparent" BorderThickness="0">
      <TabItem Header="Encaissement" Visibility="{Binding IsCashier, Converter={StaticResource BoolVisibility}}">
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right"><TextBlock Text="{Binding DailyTotal}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/><TextBlock Text="{Binding DailyCount}" Foreground="#60747D" FontSize="12"/></StackPanel><StackPanel><TextBlock Text="Une vente. En un instant." FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Retail.SessionSummary}" TextTrimming="CharacterEllipsis" Foreground="#60747D" Margin="0,5,0,0"/></StackPanel></DockPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
              <Border CornerRadius="16" Padding="12" Margin="0,0,0,10">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#103D40"/><GradientStop Color="#176C60" Offset="1"/></LinearGradientBrush></Border.Background>
                <StackPanel>
                  <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="F2 · SCANNER" Foreground="#A5E6CF" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="▥  Scannez. C’est ajouté." Foreground="White" FontSize="18" FontWeight="SemiBold"/></DockPanel>
                  <Grid><TextBox local:TouchInput.Mode="Off" x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="20" Padding="12,10" ToolTip="Lecteur USB en mode clavier, terminé par Entrée" PreviewKeyDown="BarcodeBox_KeyDown" AutomationProperties.Name="Scanner un code-barres">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ScanCommand}"/></TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Text="Passez un code-barres devant le lecteur…" Foreground="#728C8C" FontSize="14" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Barcode}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock></Grid>
                  <TextBlock Text="{Binding ScanFeedback}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C7EFDF"/><Style.Triggers><DataTrigger Binding="{Binding ScanError}" Value="True"><Setter Property="Foreground" Value="#FFE0A3"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
<TextBlock Text="Recherche produit · sans code-barres ou étiquette illisible" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=180}" PreviewKeyDown="SearchBox_KeyDown" local:TouchInput.CommitCommand="{Binding AddSearchResultCommand}" ToolTip="Nom ou référence · Entrée pour ajouter le produit trouvé" AutomationProperties.Name="Rechercher un produit"/>
            </StackPanel>
            <Grid Grid.Row="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <StackPanel><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousProductsCommand}" Padding="10,2" AutomationProperties.Name="Page précédente"/><Button Content="›" Command="{Binding NextProductsCommand}" Padding="10,2" Margin="0" AutomationProperties.Name="Page suivante"/></StackPanel><TextBlock Text="{Binding ProductCount}" Foreground="#60747D" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="196" Height="124" Margin="0,0,12,12" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Grid Width="158"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" Foreground="#087F70" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,8"/><DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Right" Text="{Binding Stock, StringFormat={}{0} en stock}" FontSize="11" Foreground="#60747D" VerticalAlignment="Center"/><TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" FontSize="21" FontWeight="Bold"/></DockPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Settings.Currency, StringFormat=Prix en {0}}" Foreground="#60747D" FontSize="11" Margin="0,8,0,0"/></StackPanel>
              </ScrollViewer>
              <Border Background="#F5F4EF" Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"><TextBlock Text="Votre première vente commence ici" FontSize="23" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Ajoutez vos articles dans l’onglet Catalogue, ou explorez la caisse avec des produits d’exemple." TextWrapping="Wrap" TextAlignment="Center" Foreground="#60747D" Margin="0,14,0,20"/><Button Content="Charger les produits d’exemple" Command="{Binding DemoCommand}" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Primary}"/></StackPanel></Border>
            </Grid>
          </Grid>
          <Border Grid.Column="2" Background="White" CornerRadius="20" Padding="20" BorderBrush="#E1E8EC" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="{Binding DiscountLabel}" Click="Discount_Click" Padding="8,6" Margin="6,0,0,0"/><Button DockPanel.Dock="Right" Content="Vider" Command="{Binding ClearCommand}" Padding="12,6" Margin="0"/><StackPanel><TextBlock Text="Votre panier" FontSize="21" FontWeight="Bold"/><TextBlock Text="{Binding CartCount}" Foreground="#60747D" Margin="0,4,0,0"/></StackPanel></DockPanel>
              <Grid Grid.Row="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><ItemsControl ItemsSource="{Binding Cart}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E9EEF1" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat={}{0:N2}}" FontWeight="Bold"/><TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left"/></DockPanel><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Retirer" Padding="8,4" Margin="0" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><StackPanel Orientation="Horizontal"><Button Content="−" Padding="11,3" Command="{Binding DataContext.MinusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Quantity}" Width="24" VerticalAlignment="Center" TextAlignment="Center"/><Button Content="+" Padding="11,3" Margin="8,0,0,0" Command="{Binding DataContext.PlusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="Votre prochaine vente commence ici.&#10;Scannez le premier article." TextAlignment="Center" Foreground="#80939C" VerticalAlignment="Center" Visibility="{Binding IsCartEmpty, Converter={StaticResource BoolVisibility}}"/></Grid>
              <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Border Background="#103D40" CornerRadius="12" Padding="16"><DockPanel><TextBlock Text="À PAYER" Foreground="#C7EFDF" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/></DockPanel></Border>
                <Button Content="Paiement / Encaisser →" Click="Payment_Click" Style="{StaticResource Primary}" MinHeight="60" Margin="0,12,0,0" FontSize="19"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Catalogue &amp; stock" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}">
        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="Vos produits" FontSize="28" FontWeight="Bold"/><TextBlock Text="{Binding StockAlert}" Foreground="#60747D" Margin="0,6,0,0"/></StackPanel><DataGrid ItemsSource="{Binding Catalog}" SelectedItem="{Binding SelectedProduct}"><DataGrid.Columns><DataGridTextColumn Header="Code-barres" Binding="{Binding Barcode}" Width="130"/><DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Prix" Binding="{Binding Price, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/></DataGrid.Columns></DataGrid></DockPanel>
          <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel><TextBlock Text="{Binding EditorTitle}" FontSize="21" FontWeight="Bold" Margin="0,0,0,18"/><TextBlock Text="Nom du produit"/><TextBox Text="{Binding EditName}" Margin="0,6,0,14"/><TextBlock Text="Code-barres / référence"/><TextBox Text="{Binding EditBarcode}" Margin="0,6,0,4"/><TextBlock Text="Sans code-barres : laissez vide, une référence sera créée." TextWrapping="Wrap" Foreground="#60747D" FontSize="11" Margin="0,0,0,14"/><TextBlock Text="Catégorie"/><ComboBox ItemsSource="{Binding EditorCategories}" Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" Margin="0,6,0,14" AutomationProperties.Name="Catégorie du produit" ToolTip="Choisissez une catégorie ou saisissez une nouvelle catégorie"/><TextBlock Text="{Binding Settings.Currency, StringFormat=Prix de vente ({0})}"/><TextBox Text="{Binding EditPrice}" Margin="0,6,0,14"/><TextBlock Text="Quantité en stock"/><TextBox Text="{Binding EditStock}" Margin="0,6,0,14"/><TextBlock Text="Toute modification du stock crée un mouvement d’ajustement." TextWrapping="Wrap" Foreground="#60747D" FontSize="12" Margin="0,0,0,20"/><Button Content="Enregistrer le produit" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0,0,0,10"/><Button Content="Nouveau produit" Command="{Binding NewCommand}" Margin="0"/></StackPanel></ScrollViewer></Border>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding HistoryTitle}">
        <DockPanel Margin="0,20,0,0"><Grid DockPanel.Dock="Top" Margin="0,0,0,18"><StackPanel><TextBlock Text="Journal des ventes" FontSize="28" FontWeight="Bold"/><TextBlock Text="Sélectionnez une vente pour consulter ou réimprimer son ticket." Foreground="#60747D" Margin="0,6,0,0"/></StackPanel><Button Content="Ouvrir le ticket" Command="{Binding ReceiptCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"><DataGrid.Columns><DataGridTextColumn Header="Référence" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Date (UTC)" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/><DataGridTextColumn Header="Paiement" Binding="{Binding PaymentMethod}" Width="190"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Reçu" Binding="{Binding Tendered, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Rendu" Binding="{Binding Change, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid></DockPanel>
      </TabItem>
      <TabItem Header="Données" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}">
        <Grid Margin="0,20,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20"><TextBlock Text="Votre magasin, en tableaux." FontSize="28" FontWeight="Bold"/><TextBlock Text="Consultez le stock restant et emportez vos chiffres dans Excel." Foreground="#60747D" Margin="0,6,0,0"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#103D40" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="Vos tableaux Excel" FontSize="21" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Stock restant, ventes, caissiers, sessions et retours. Un classeur facile à lire, filtrer et partager." Foreground="#C7EFDF" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="Exporter les tableaux Excel…" Click="ExportData_Click" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border>
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="Protéger vos données" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="La sauvegarde quotidienne est automatique. Gardez aussi une copie sur une clé USB pour restaurer la caisse si nécessaire." Foreground="#60747D" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="Créer une copie de restauration…" Click="Backup_Click" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="Stock restant aujourd’hui" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding StockAlert}" Foreground="#60747D" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
          <DataGrid Grid.Row="3" ItemsSource="{Binding Catalog}"><DataGrid.Columns>
            <DataGridTextColumn Header="Code / référence" Binding="{Binding Barcode}" Width="190"/>
            <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="*" MinWidth="160"/>
            <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="170"/>
            <DataGridTextColumn Header="Prix de vente" Binding="{Binding Price, StringFormat=N2}" Width="140"/>
            <DataGridTextColumn Header="Quantité restante" Binding="{Binding Stock}" Width="160"/>
          </DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="{Binding ManagementTitle}"><local:RetailPanel DataContext="{Binding Retail}"/></TabItem>
      <TabItem Header="Tableau de bord" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}"><local:DashboardPanel DataContext="{Binding Dashboard}"/></TabItem>
      <TabItem Header="Journal" Visibility="{Binding IsManager, Converter={StaticResource BoolVisibility}}">
        <DockPanel Margin="0,20,0,0"><TextBlock DockPanel.Dock="Top" Text="Journal des opérations · lecture seule" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
          <DataGrid ItemsSource="{Binding AuditLog}"><DataGrid.Columns>
            <DataGridTextColumn Header="Date UTC" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="190"/>
            <DataGridTextColumn Header="Compte" Binding="{Binding UserName}" Width="120"/><DataGridTextColumn Header="Shift" Binding="{Binding CashSessionId}" Width="70"/>
            <DataGridTextColumn Header="Caisse" Binding="{Binding Register}" Width="160"/><DataGridTextColumn Header="Opération" Binding="{Binding Action}" Width="160"/>
            <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="*" MinWidth="240"/>
          </DataGrid.Columns></DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E4EEEB" Padding="24,12"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="4"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#215A4B"/></Border>
  </Grid>
</Window>
